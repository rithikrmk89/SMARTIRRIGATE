# ==============================================================
# SmartIrrigate Cloud Environment Configuration Template
# Copy this file to .env for local overrides
# DO NOT COMMIT REAL CLOUD SECRETS OR SENSITIVE TOKENS TO GIT
# ==============================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Storage Mode (local or azure)
# When AZURE_STORAGE_ENABLED is false, SQLite and local filesystem are used seamlessly.
AZURE_STORAGE_ENABLED=false
LOCAL_STORAGE_DIR=./data_storage

# Microsoft Azure Cloud Storage (Optional - only required when AZURE_STORAGE_ENABLED=true)
# Option A: Connection String
AZURE_STORAGE_CONNECTION_STRING=
# Option B: Storage Account Name & Key (or Managed Identity)
AZURE_STORAGE_ACCOUNT_NAME=smartirrigatestore
AZURE_STORAGE_ACCOUNT_KEY=

# Azure Blob Container Names
AZURE_RAW_CONTAINER=smartirrigate-raw-data
AZURE_PROCESSED_CONTAINER=smartirrigate-processed
AZURE_MODELS_CONTAINER=smartirrigate-models

# Azure Machine Learning (Optional)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=smartirrigate-rg
AZURE_ML_WORKSPACE_NAME=smartirrigate-aml
AZURE_ML_COMPUTE_NAME=cpu-cluster

# Microsoft Power BI (Optional Cloud Dashboard URL)
AZURE_POWERBI_DASHBOARD_URL=

# ML Training Hyperparameters & Defaults
DEFAULT_MODEL_TYPE=random_forest
RANDOM_STATE=42
TEST_SPLIT_RATIO=0.2
DEFAULT_ESTIMATORS=100
MAX_DEPTH=12
